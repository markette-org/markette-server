DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4200
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=markette
POSTGRES_USER=markette
POSTGRES_PASSWORD=markette
REDIS_URL=redis://localhost:6379/0

# Networks (leave empty to hide a provider)
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202509
LINKEDIN_ORG_SCOPES=false
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Optional "Add to Slack" app; without it users paste a bot token
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# AI: OpenRouter (default) or any OpenAI-compatible API (OpenAI, Azure, vLLM, Ollama, LiteLLM…).
# Without a key (or, for openai_compatible, a base URL) the statistical best-time engine still works.
# Everything here can also be set in Platform → Settings.
AI_PROVIDER=openrouter
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=openrouter/auto
AI_EFFORT=
AI_STRUCTURED_OUTPUT=json_schema
# Only used to estimate cost when the provider does not report it (USD per million tokens).
AI_PRICE_INPUT_PER_MTOK=0
AI_PRICE_OUTPUT_PER_MTOK=0

# Billing (Stripe). Webhook: {PUBLIC_API_URL}/api/billing/webhook/ (also editable in Platform → Settings)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# MCP server, served at {PUBLIC_API_URL}/mcp by the "mcp" container
# PUBLIC_MCP_URL=

# Threads (Meta app, Threads use case) and Google (YouTube)
THREADS_APP_ID=
THREADS_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
